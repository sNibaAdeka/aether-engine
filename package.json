{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AETHER — photorealistic procedural open world on three.js / WebGPU",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
